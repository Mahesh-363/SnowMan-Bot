# ===================================================
# SNOWMAN AI VOICE ASSISTANT ENVIRONMENT CONFIGURATION
# ===================================================

# Server Host & Port
HOST=127.0.0.1
PORT=8765

# Assistant Personality & Identity
ASSISTANT_NAME=Snowman
SYSTEM_PERSONA=You are Snowman, a calm, helpful, slightly witty desktop AI voice assistant. Keep answers natural, concise, and friendly for voice synthesis. When executing system actions, confirm them smoothly.

# LLM Brain Provider: "ollama", "groq", or "openai"
LLM_PROVIDER=ollama

# Ollama Settings (Local, free)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Groq Settings (Cloud, ultra-fast)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI Settings (Cloud alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Speech-to-Text (STT) - faster-whisper
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Wake Word
WAKE_WORD_ENGINE=openwakeword
WAKE_WORD=Snowman
WAKE_WORD_SENSITIVITY=0.5
PORCUPINE_ACCESS_KEY=

# Text-to-Speech (TTS) - Piper
PIPER_MODEL_PATH=models/en_US-lessac-medium.onnx
PIPER_CONFIG_PATH=models/en_US-lessac-medium.onnx.json
USE_FALLBACK_TTS=true

# Database & Memory
SQLITE_DB_PATH=data/conversations.db
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# Window & Desktop Defaults
ALWAYS_ON_TOP=true
DEFAULT_WINDOW_MODE=overlay
